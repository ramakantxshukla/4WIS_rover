<launch>
    <let name="slam_params_path"
         value="$(find-pkg-share my_robot_bringup)/config/src/my_robot_bringup/config/mapper_params_online_async.yaml"/>
    <let name="rviz_config_path"
         value="$(find-pkg-share my_robot_bringup)/rviz/navigation.rviz"/>

    <arg name="use_sim_time" default="true"/>
    <arg name="rviz" default="true"/>

    <!-- Use slam_toolbox's own launch file -->
    <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="slam_params_file" value="$(var slam_params_path)"/>
    </include>

    <node pkg="rviz2" exec="rviz2" if="$(var rviz)" output="screen"
          args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
</launch>
