<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.1" />
    <xacro:property name="camera_height" value="0.05" />
    <!-- Camera link -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" x="${camera_length}" y="${camera_width}" z="${camera_height}"
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>
....
    <!-- Joint to parent -->
    <joint name="camera_joint" type="fixed">
      <!-- <parent link="base_footprint" /> -->
      <parent link="base_link" />

      <child link="camera_link" />
    <origin xyz="${(base_length + camera_length) / 2.0} 0 ${base_height / 2.0}" rpy="0 0 0" />

    </joint>

    <!-- Camera optical frame -->
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link" />
      <child link="camera_optical_frame" />
      <origin xyz="0 0 0" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="camera_optical_frame">
      <inertial>
        <mass value="0.01" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
      </inertial>
    </link>

    <!-- Fixed Gazebo sensor configuration -->
    <gazebo reference="camera_optical_frame">
      <sensor name="camera_camera" type="rgbd_camera">
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera name="camera_camera">
          <horizontal_fov>1.2043</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>915.3003540039062</fx>
              <fy>914.0320434570312</fy>
              <cx>642.724365234375</cx>
              <cy>361.9780578613281</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>0</visualize>
        <topic>camera</topic>
      </sensor>

    </gazebo>

    <!-- <gazebo>
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
    </gazebo> -->

</robot>